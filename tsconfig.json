{
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "types": [
      "./declaration.d.ts",
      "./internal.d.ts",
      "node"
    ],
    "module": "CommonJS",
    "target": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}