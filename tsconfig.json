{
    "compilerOptions": {
        "esModuleInterop": true,
        "outDir": "./dist",
        "types": ["./declaration.d.ts", "./internal.d.ts", "bun"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ESNext",
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,
        "noEmit": true
    }
}
